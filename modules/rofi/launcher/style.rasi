/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} {c}";
    icon-theme:                 "Papirus-Dark";
}


/*****----- Global Properties -----*****/
* {
    font:                        "Iosevka Nerd Font 11";

    /* Paleta glassmorphism — coherente con bordes Hyprland */
    bg-base:                     rgba(10, 10, 18, 0.55);
    bg-panel:                    rgba(20, 20, 35, 0.60);
    bg-item:                     rgba(30, 30, 50, 0.50);
    bg-selected:                 rgba(245, 194, 231, 0.20);

    border-glass:                rgba(245, 194, 231, 0.18);
    border-glow:                 rgba(245, 194, 231, 0.55);

    fg-primary:                  rgba(239, 240, 241, 0.95);
    fg-muted:                    rgba(161, 162, 164, 0.70);
    accent:                      #f5c2e7;
    accent-dim:                  rgba(245, 194, 231, 0.75);
    accent-on-dark:              #1a1a2e;

    /* Aliases legacy */
    background:                  @bg-base;
    background-alt:              @bg-item;
    foreground:                  @fg-primary;
    selected:                    @accent;
    active:                      @accent;
    urgent:                      rgba(243, 139, 168, 0.90);
}


/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       460px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               18px;
    border:                      1px;
    border-color:                @border-glass;
    cursor:                      "default";
    background-color:            @bg-base;
}


/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "listview" ];
}


/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     18px 18px 14px 18px;
    background-color:            transparent;
    text-color:                  @fg-primary;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry" ];

    border:                      0px 0px 1px 0px;
    border-color:                @border-glass;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " ";
    padding:                     10px 14px 10px 14px;
    border-radius:               10px;
    background-color:            rgba(245, 194, 231, 0.15);
    text-color:                  @accent;
    border:                      1px;
    border-color:                @border-glass;
}

entry {
    enabled:                     true;
    expand:                      true;
    padding:                     10px 14px 10px 14px;
    border-radius:               10px;
    background-color:            rgba(255, 255, 255, 0.06);
    text-color:                  @fg-primary;
    cursor:                      text;
    placeholder:                 "Buscar aplicación...";
    placeholder-color:           @fg-muted;
    border:                      1px;
    border-color:                @border-glass;
}

dummy {
    expand:                      true;
    background-color:            transparent;
}


/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                     true;
    spacing:                     6px;
    padding:                     10px 18px;
    background-color:            transparent;
    text-color:                  @fg-muted;
    border:                      0px 0px 1px 0px;
    border-color:                @border-glass;
}

button {
    padding:                     8px 20px;
    border-radius:               8px;
    background-color:            rgba(255, 255, 255, 0.05);
    text-color:                  @fg-muted;
    cursor:                      pointer;
    border:                      1px;
    border-color:                @border-glass;
}

button selected {
    background-color:            rgba(245, 194, 231, 0.18);
    text-color:                  @accent;
    border-color:                @border-glow;
}


/*****----- Listview -----*****/
listview {
    padding:                     10px;
    margin:                      12px 12px 16px 12px;
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     4px;
    border-radius:               12px;
    background-color:            rgba(255, 255, 255, 0.04);
    text-color:                  @fg-primary;
    cursor:                      "default";

    border:                      1px;
    border-color:                @border-glass;
}


/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     0px;
    padding:                     8px 10px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @fg-primary;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @fg-primary;
}

element normal.active {
    background-color:            rgba(245, 194, 231, 0.08);
    text-color:                  @accent;
}

element selected.normal {
    background-color:            rgba(245, 194, 231, 0.16);
    text-color:                  @fg-primary;
    border:                      1px;
    border-color:                @border-glow;
}

element selected.active {
    background-color:            rgba(245, 194, 231, 0.22);
    text-color:                  @accent;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @fg-primary;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        34px;
    cursor:                      inherit;
}

element-text {
    padding:                     0px 14px;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0;
}


/*****----- Message -----*****/
message {
    background-color:            transparent;
    padding:                     8px 18px;
}

textbox {
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            rgba(255, 255, 255, 0.05);
    text-color:                  @fg-muted;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

error-message {
    padding:                     10px;
    border-radius:               10px;
    background-color:            rgba(243, 139, 168, 0.15);
    text-color:                  rgba(243, 139, 168, 0.95);
}
